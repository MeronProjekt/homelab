# Anthropic API
ANTHROPIC_API_KEY=<DEIN-ANTHROPIC-API-KEY>
CLAUDE_MODEL=claude-haiku-4-5-20251001
CLAUDE_MODEL_HEAVY=claude-sonnet-4-6

# Telegram
TELEGRAM_BOT_TOKEN=<DEIN-TELEGRAM-BOT-TOKEN>
